---
import { getCollection } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import Section from "@/components/common/Section.astro"
import AuthorLinks from "@/components/content/AuthorLinks.astro"
import { getModuleSlug, getNoteSlug, isModule } from "@/lib/content"
import { formatDateUppercase } from "@/lib/utils"
import { authorIds, getAuthor, hasAuthorProfile, type AuthorId } from "../../../data/authors"

export async function getStaticPaths() {
  return authorIds.filter(hasAuthorProfile).map((slug) => ({ params: { slug } }))
}

const author = getAuthor(Astro.params.slug as AuthorId)
const profile = author.profile
const posts = (await getCollection("posts", ({ data }) => !data.draft && data.authors.includes(author.id)))
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf())
const learning = await getCollection("learning", ({ data }) => !data.draft && data.authors.includes(author.id))
const modules = learning.filter(isModule)
const notes = learning.filter((entry) => !isModule(entry))
const initials = author.name.split(" ").map((part) => part[0]).slice(0, 2).join("")
---

<BaseLayout title={`${author.name} — Physica`} description={profile?.bio ?? `Work by ${author.name} on Physica.`}>
  <Section frameClass="max-w-[64rem]">
    <header class="px-5 py-12 md:px-10 md:py-16 lg:px-15">
      <a href="/post" class="font-mono text-xs text-accent-1 hover:text-accent-2">← All articles</a>
      <div class="mt-10 grid gap-7 md:grid-cols-[6rem_minmax(0,1fr)] md:gap-8">
        <div aria-hidden="true" class="flex size-20 items-center justify-center rounded-2xl border border-border bg-background-1 font-display text-2xl font-semibold text-accent-1 md:size-24">{initials}</div>
        <div>
          <p class="font-mono text-xs tracking-[0.14em] text-accent-1 uppercase">Author</p>
          <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-foreground-0 md:text-5xl">{author.name}</h1>
          {author.role && <p class="mt-4 inline-flex rounded-full border border-border px-3 py-1 font-mono text-xs text-foreground-2">{author.role}</p>}
          {profile?.bio && <p class="mt-6 max-w-2xl text-lg leading-8 text-foreground-2">{profile.bio}</p>}
          {profile?.links && profile.links.length > 0 && <ul class="mt-7 flex flex-wrap gap-2">{profile.links.map((link) => <li><a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-md border border-border px-3 py-2 text-sm text-foreground-1 transition-colors hover:border-accent-1 hover:text-accent-1">{link.label} ↗</a></li>)}</ul>}
        </div>
      </div>
    </header>
  </Section>

  {posts.length > 0 && <Section frameClass="max-w-[64rem]">
    <section class="px-5 py-12 md:px-10 lg:px-15" aria-labelledby="author-articles">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-mono text-xs tracking-[0.14em] text-accent-1 uppercase">Writing</p>
          <h2 id="author-articles" class="mt-2 font-display text-3xl font-semibold text-foreground-0">Recent articles</h2>
        </div>
        <a href={`/post/${author.id}`} class="rounded-md border border-border px-4 py-2 text-sm text-foreground-1 transition-colors hover:border-accent-1 hover:text-accent-1">All articles by {author.name} →</a>
      </div>
      <ol class="mt-8 grid gap-3 md:grid-cols-2">
        {posts.slice(0, 4).map((post) => <li class="rounded-lg border border-border p-5 transition-colors hover:bg-background-1">
          <p class="font-mono text-xs text-foreground-3"><time datetime={post.data.pubDatetime.toISOString()}>{formatDateUppercase(post.data.pubDatetime)}</time></p>
          <h3 class="mt-4 font-display text-xl font-semibold leading-snug text-foreground-0"><a href={`/post/${post.id}`} class="hover:text-accent-1">{post.data.title}</a></h3>
          <p class="mt-3 line-clamp-2 text-sm leading-6 text-foreground-2">{post.data.description}</p>
          {post.data.authors.length > 1 && <p class="mt-4 font-mono text-xs text-foreground-3"><AuthorLinks authors={post.data.authors} /></p>}
        </li>)}
      </ol>
    </section>
  </Section>}

  {modules.length > 0 && <Section frameClass="max-w-[64rem]">
    <section class="px-5 py-12 md:px-10 lg:px-15" aria-labelledby="author-modules">
      <h2 id="author-modules" class="font-display text-3xl font-semibold text-foreground-0">Modules</h2>
      <ul class="mt-6 divide-y divide-border">{modules.map((module) => <li><a href={`/${getModuleSlug(module)}`} class="group block py-5"><h3 class="font-display text-lg font-semibold text-foreground-0 group-hover:text-accent-1">{module.data.title}</h3>{module.data.description && <p class="mt-2 text-sm leading-6 text-foreground-2">{module.data.description}</p>}</a></li>)}</ul>
    </section>
  </Section>}

  {notes.length > 0 && <Section frameClass="max-w-[64rem]">
    <section class="px-5 py-12 md:px-10 lg:px-15" aria-labelledby="author-notes">
      <h2 id="author-notes" class="font-display text-3xl font-semibold text-foreground-0">Notes</h2>
      <ul class="mt-6 divide-y divide-border">{notes.map((note) => <li><a href={`/${getNoteSlug(note)}`} class="group block py-5"><h3 class="font-display text-lg font-semibold text-foreground-0 group-hover:text-accent-1">{note.data.title}</h3>{note.data.description && <p class="mt-2 text-sm leading-6 text-foreground-2">{note.data.description}</p>}</a></li>)}</ul>
    </section>
  </Section>}

  {posts.length === 0 && modules.length === 0 && notes.length === 0 && <Section frameClass="max-w-[64rem]"><p class="px-5 py-12 text-foreground-2 md:px-10 lg:px-15">No published work yet.</p></Section>}
</BaseLayout>
