---
import { getCollection, render } from "astro:content"
import type { CollectionEntry } from "astro:content"
import { Icon } from "astro-icon/components"
import BaseLayout from "@/layouts/BaseLayout.astro"
import Section from "@/components/common/Section.astro"
import { getModuleSlug, getNoteSlug, isModule } from "@/lib/content"
import { formatDateUppercase } from "@/lib/utils"
export async function getStaticPaths() {
  return (await getCollection("authors")).map((author) => ({ params: { slug: author.id }, props: { author } }))
}

const { author } = Astro.props as { author: CollectionEntry<"authors"> }
const { Content } = await render(author)
const posts = (await getCollection("posts", ({ data }) => !data.draft && data.authors.some((item) => item.id === author.id)))
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf())
const learning = await getCollection("learning", ({ data }) => !data.draft && data.authors.some((item) => item.id === author.id))
const modules = learning.filter(isModule)
const notes = learning.filter((entry) => !isModule(entry))
const initials = author.data.name.split(" ").map((part) => part[0]).slice(0, 2).join("")
---

<BaseLayout title={`${author.data.name} — Physica`} description={`Work by ${author.data.name} on Physica.`} showFooterBorder={false}>
  <Section frameClass="max-w-[68rem]">
    <div class="px-(--page-gutter) py-(--section-space)">
      <header class="grain-surface grain-surface--always rounded-2xl bg-background-1 p-7 md:p-10" style="--grain-color: var(--teal-0); --grain-position: 12% 0%">
        <p class="font-mono text-xs text-teal-0">Physica contributor</p>
        <div class="mt-8 flex flex-col gap-7 sm:flex-row sm:items-center sm:gap-8">
          <div aria-hidden="true" class="flex size-20 shrink-0 items-center justify-center rounded-2xl bg-background-2/70 font-display text-2xl font-medium text-teal-0 md:size-24">{initials}</div>
          <div>
            <h1 class="font-display text-[clamp(2.5rem,5vw,4rem)] font-medium leading-tight tracking-tight text-foreground-0">{author.data.name}</h1>
            {author.data.role && <p class="mt-2 text-sm text-foreground-2">{author.data.role}</p>}
          </div>
        </div>
        {author.data.links.length > 0 && <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-3">{author.data.links.map((link) => <li><a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-foreground-1 transition-colors hover:text-teal-0"><Icon name={link.icon} class="size-4" aria-hidden="true" /><span>{link.label}</span><Icon name="arrow-up-right" class="size-3.5 text-foreground-3" aria-hidden="true" /></a></li>)}</ul>}
      </header>

      {author.body && <div class="prose mt-10 max-w-3xl"><Content /></div>}

      {posts.length > 0 && <section class="mt-16" aria-labelledby="author-articles">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="author-articles" class="font-display text-3xl font-medium text-foreground-0">Articles</h2>
          <a href={`/post/${author.id}`} class="inline-flex items-center gap-2 text-sm text-accent-1 hover:text-accent-2">All articles <Icon name="arrow-right" class="size-4" aria-hidden="true" /></a>
        </div>
        <ol class="mt-6 grid gap-4 md:grid-cols-2">
          {posts.slice(0, 4).map((post) => <li><a href={`/post/${post.id}`} class="grain-surface grain-surface--hover group flex h-full min-h-52 flex-col rounded-xl bg-background-1 p-6 transition-colors duration-300 hover:bg-background-2/70 focus-visible:outline-2 focus-visible:outline-accent-1 focus-visible:outline-offset-2">
            <time datetime={post.data.pubDatetime.toISOString()} class="font-mono text-xs text-foreground-3">{formatDateUppercase(post.data.pubDatetime)}</time>
            <h3 class="mt-5 font-display text-xl font-medium leading-snug text-foreground-0 transition-colors group-hover:text-accent-1">{post.data.title}</h3>
            <p class="mt-3 line-clamp-2 text-sm leading-6 text-foreground-2">{post.data.description}</p>
          </a></li>)}
        </ol>
      </section>}

      {modules.length > 0 && <section class="mt-16" aria-labelledby="author-modules">
        <h2 id="author-modules" class="font-display text-3xl font-medium text-foreground-0">Modules</h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-2">{modules.map((module) => <li><a href={`/${getModuleSlug(module)}`} class="grain-surface grain-surface--hover group block h-full rounded-xl bg-background-1 p-6 transition-colors duration-300 hover:bg-background-2/70"><h3 class="font-display text-xl font-medium text-foreground-0 transition-colors group-hover:text-accent-1">{module.data.title}</h3>{module.data.description && <p class="mt-3 text-sm leading-6 text-foreground-2">{module.data.description}</p>}</a></li>)}</ul>
      </section>}

      {notes.length > 0 && <section class="mt-16" aria-labelledby="author-notes">
        <h2 id="author-notes" class="font-display text-3xl font-medium text-foreground-0">Notes</h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-2">{notes.map((note) => <li><a href={`/${getNoteSlug(note)}`} class="grain-surface grain-surface--hover group block h-full rounded-xl bg-background-1 p-6 transition-colors duration-300 hover:bg-background-2/70"><h3 class="font-display text-xl font-medium text-foreground-0 transition-colors group-hover:text-accent-1">{note.data.title}</h3>{note.data.description && <p class="mt-3 text-sm leading-6 text-foreground-2">{note.data.description}</p>}</a></li>)}</ul>
      </section>}

      {posts.length === 0 && modules.length === 0 && notes.length === 0 && <p class="mt-12 text-foreground-2">No published work yet.</p>}
    </div>
  </Section>
</BaseLayout>
