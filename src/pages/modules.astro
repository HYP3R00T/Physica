---
import { getCollection } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import Section from "@/components/common/Section.astro"
import ModuleCard from "@/components/content/ModuleCard.astro"
import { getModuleNotes, isModule } from "@/lib/content"
import "../styles/components/modules.css"

const learning = await getCollection("learning", ({ data }) => !data.draft)
const modules = learning.filter(isModule).sort((a, b) => a.data.title.localeCompare(b.data.title))
---

<BaseLayout title="Modules | Physica" description="Find a physics module and study its notes, one topic at a time.">
  <Section frameClass="module-directory">
    <header class="module-directory-intro">
      <h1>Modules</h1>
      <p>Study one topic at a time. Each module brings its notes together in reading order.</p>
    </header>
    <div class="module-results">
      {modules.map(module => <ModuleCard module={module} noteCount={getModuleNotes(learning, module).length} />)}
    </div>
  </Section>
</BaseLayout>
