---
import { Icon } from "astro-icon/components"
import Section from "@/components/common/Section.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import MechanicsArt from "@/assets/subjects/classical-mechanics.svg"
import ElectromagnetismArt from "@/assets/subjects/electromagnetism.svg"
import ThermodynamicsArt from "@/assets/subjects/thermodynamics.svg"
import QuantumArt from "@/assets/subjects/quantum-mechanics.svg"
import RelativityArt from "@/assets/subjects/relativity.svg"

const subjects = [
  { slug: "classical-mechanics", title: "Classical mechanics", question: "How does the world move?", color: "red", art: MechanicsArt },
  { slug: "electromagnetism", title: "Electromagnetism", question: "How do charges shape our world?", color: "orange", art: ElectromagnetismArt },
  { slug: "thermodynamics-and-statistical-mechanics", title: "Thermodynamics & statistical mechanics", question: "How does the small become the large?", color: "green", art: ThermodynamicsArt },
  { slug: "quantum-mechanics", title: "Quantum mechanics", question: "What changes at the quantum scale?", color: "purple", art: QuantumArt },
  { slug: "relativity", title: "Relativity", question: "What do space and time have in common?", color: "cyan", art: RelativityArt },
]
---

<BaseLayout title="Physica | Find your way through physics" description="Study physics through modules and notes, and explore a roadmap connecting the topics and their prerequisites.">
  <div class="[&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-accent-1 [&_a:focus-visible]:outline-offset-4">
    <Section>
      <div class="editorial-frame pt-[clamp(5rem,11vw,10rem)] pb-4 md:pb-10">
        <div class="max-w-5xl">
          <h1 class="font-display text-[clamp(3rem,6vw,5.5rem)] leading-[1.04] font-medium tracking-[-.06em]">Follow your curiosity.<br /><span class="home-hero-accent">Build your understanding.</span></h1>
          <p class="mt-8 max-w-2xl text-lg leading-[1.7] text-foreground-2">Read through a module, explore how ideas connect, and find your next step in physics.</p>
          <div class="mt-9 flex flex-wrap items-center gap-3 text-sm font-medium">
            <a href="/modules" class="grain-surface grain-surface--hover home-hero-action home-hero-action--primary inline-flex items-center gap-2 rounded-lg px-5 py-3.5 text-accent-1">Explore modules <Icon name="arrow-right" class="size-4" aria-hidden="true" /></a>
            <a href="/roadmap" class="grain-surface grain-surface--hover home-hero-action inline-flex items-center gap-2 rounded-lg px-5 py-3.5 text-foreground-1">View roadmap <Icon name="arrow-right" class="size-4" aria-hidden="true" /></a>
          </div>
        </div>
      </div>
    </Section>

    <Section id="subjects" class="scroll-mt-20">
      <div class="editorial-frame pb-(--section-space)">
        <div class="max-w-3xl">
          <h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] font-medium tracking-tight">What draws you in?</h2>
          <p class="mt-4 text-lg leading-8 text-foreground-2">Pick an idea that interests you. The roadmap shows what to learn along the way.</p>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-2">
          {subjects.map(subject => (
            <a class="home-subject-card group flex min-h-60 flex-col rounded-xl bg-background-1 p-7 md:min-h-72 md:p-9" href={`/roadmap?subject=${subject.slug}`} style={`--subject-color: var(--${subject.color}-0)`}>
              <subject.art class="h-20 w-28 shrink-0 text-(--subject-color) md:h-24 md:w-32" aria-hidden="true" />
              <div class="mt-auto pt-8">
                <p class="text-sm text-foreground-2">{subject.question}</p>
                <h3 class="mt-2 font-display text-xl font-medium tracking-tight md:text-2xl">{subject.title}</h3>
              </div>
            </a>
          ))}
          <a class="home-roadmap-card group flex min-h-60 flex-col rounded-xl bg-background-1 p-7 transition-colors duration-300 hover:bg-background-2/70 motion-reduce:transition-none md:min-h-72 md:p-9" href="/roadmap">
            <Icon name="arrow-right" class="size-8 text-accent-1" aria-hidden="true" />
            <div class="mt-auto pt-8">
              <p class="text-sm text-foreground-2">Keep exploring</p>
              <h3 class="mt-2 font-display text-xl font-medium tracking-tight transition-colors duration-300 group-hover:text-accent-1 motion-reduce:transition-none md:text-2xl">See the whole roadmap.</h3>
            </div>
          </a>
        </div>
      </div>
    </Section>
  </div>
</BaseLayout>
