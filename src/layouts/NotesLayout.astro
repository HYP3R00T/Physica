---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ReadingToc from "@/components/content/ReadingToc.astro"
import { getModuleSlug, getNoteSlug } from "@/lib/content"
import type { LearningEntry } from "@/lib/content"

import "katex/dist/katex.min.css"

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  description?: string
  module: LearningEntry
  notes: LearningEntry[]
  currentId?: string
  headings?: Heading[]
}

const { title, description, module, notes, currentId, headings = [] } = Astro.props as Props

---

<BaseLayout
  title={`${title} — Physica`}
  description={description ?? "Study notes"}
  contentType="article"
  layout="notes"
  showFooterBorder={false}
>
  <div class="reading-layout min-h-[calc(100vh-4rem)] items-start">
    <aside class="sticky top-24 hidden max-h-[calc(100vh-6rem)] overflow-y-auto py-8 min-[72rem]:block" aria-label="Notes">
      <h2 class="mb-4 px-3 font-sans text-xs font-semibold tracking-wide text-foreground-2">In this module</h2>
      <nav aria-label={`${module.data.title} notes`}>
        <ul class="space-y-1 rounded-xl bg-background-1 p-2">
          {
            notes.map((note) => (
              <li>
                <a
                  href={`/${getNoteSlug(note)}`}
                  aria-current={note.id === currentId ? "page" : undefined}
                  class:list={["grain-surface block rounded-lg px-3 py-2.5 text-sm leading-5 transition-colors duration-300", note.id === currentId ? "grain-surface--always bg-background-2/70 font-medium text-accent-1" : "grain-surface--hover text-foreground-3 hover:bg-background-2/70 hover:text-foreground-1"]}
                >
                  {note.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <div class="reading-main">
      <details class="py-5 min-[72rem]:hidden">
        <summary class="cursor-pointer font-mono text-sm font-medium text-foreground-1">Browse notes</summary>
        <nav class="mt-4 grid gap-1" aria-label="Mobile notes navigation">
          <a href={`/${getModuleSlug(module)}`} class="rounded-md px-3 py-2 text-sm text-foreground-2 hover:bg-background-1">
            {module.data.title} overview
          </a>
          {
            notes.map((note) => (
              <a
                href={`/${getNoteSlug(note)}`}
                aria-current={note.id === currentId ? "page" : undefined}
                class="rounded-md px-3 py-2 text-sm text-foreground-2 hover:bg-background-1 aria-[current=page]:bg-background-1 aria-[current=page]:text-accent-1"
              >
                {note.data.title}
              </a>
            ))
          }
        </nav>
      </details>

      <slot />
    </div>

    <ReadingToc headings={headings} />
  </div>
</BaseLayout>
