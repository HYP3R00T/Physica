---
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"
import BaseLayout from "@/layouts/BaseLayout.astro"
import AuthorLinks from "@/components/content/AuthorLinks.astro"
import ReadingToc from "@/components/content/ReadingToc.astro"
import { formatDateUppercase, estimateReadTime } from "@/lib/utils"
import "katex/dist/katex.min.css"

const { title, description, pubDatetime, category, tags, authors, cover, coverAlt, headings = [], body } = Astro.props
const tableOfContents = headings.filter(({ depth }: { depth: number }) => depth === 2 || depth === 3)
const visibleTags = tags.filter((tag: string) => tag.toLocaleLowerCase() !== category?.toLocaleLowerCase())
const topicColors = ["--teal-0", "--purple-0", "--orange-0", "--green-0", "--cyan-0"]
---

<BaseLayout title={`${title} — Physica`} description={description} image={cover} imageAlt={coverAlt} contentType="article" layout="notes" showFooterBorder={false}>
  <div class="reading-layout reading-layout--post min-h-[calc(100vh-4rem)] items-start">
    <article class="reading-main">
      <header class="grain-surface grain-surface--always mt-10 rounded-xl bg-background-1 p-6 md:-mx-6 md:mt-16 md:p-8" style="--grain-color: var(--purple-0)">
        <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
          <a href="/post" class="inline-flex items-center gap-2 text-accent-1 transition-colors hover:text-accent-2"><Icon name="arrow-left" class="size-3.5" aria-hidden="true" />All articles</a>
          <span class="text-purple-0">{category ?? "Article"}</span>
        </div>
        <h1 class="mt-8 font-display text-[clamp(2.5rem,4vw,3.8rem)] leading-[1.08] font-medium tracking-tight text-foreground-0">{title}</h1>
        <p class="mt-6 text-lg leading-8 text-foreground-2">{description}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm text-foreground-2">
          {authors.length > 0 && <><AuthorLinks authors={authors} /><span aria-hidden="true">·</span></>}
          <time datetime={pubDatetime.toISOString()}>{formatDateUppercase(pubDatetime)}</time>
          <span aria-hidden="true">·</span>
          <span>{estimateReadTime(body ?? "")} min read</span>
        </div>
        {visibleTags.length > 0 && <ul class="mt-6 flex flex-wrap gap-2" aria-label="Article topics">{visibleTags.map((tag: string, index: number) => <li class="rounded-md bg-background-2/70 px-3 py-1.5 text-xs text-foreground-2 transition-colors duration-300 hover:text-(--topic-color)" style={`--topic-color: var(${topicColors[index % topicColors.length]})`}>{tag}</li>)}</ul>}
      </header>
      <figure class="mt-8 overflow-hidden rounded-xl bg-background-1 p-1.5 md:-mx-4"><Image src={cover} alt={coverAlt || title} class="aspect-video w-full rounded-lg object-cover" /></figure>
      {tableOfContents.length > 0 && <details class="mt-6 rounded-lg bg-background-1 p-4 min-[72rem]:hidden">
        <summary class="cursor-pointer font-mono text-sm text-foreground-1">On this page</summary>
        <nav class="mt-4 grid gap-2" aria-label="Article sections">
          {tableOfContents.map((heading: { depth: number; slug: string; text: string }) => <a class:list={["text-sm leading-6 text-foreground-2 hover:text-accent-1", heading.depth === 3 && "pl-3"]} href={`#${heading.slug}`}>{heading.text}</a>)}
        </nav>
      </details>}
      <div class="prose pt-12 pb-12"><slot /></div>
      <a href="/post" class="grain-surface grain-surface--hover group mb-20 flex min-h-28 items-center justify-between gap-5 rounded-xl bg-background-1 p-6 transition-colors duration-300 hover:bg-background-2/70 focus-visible:outline-2 focus-visible:outline-accent-1 focus-visible:outline-offset-2 motion-reduce:transition-none">
        <span><span class="block font-mono text-xs text-foreground-3">Finished reading</span><span class="mt-2 block font-display text-xl font-medium text-foreground-0 transition-colors duration-300 group-hover:text-accent-1 motion-reduce:transition-none">Browse all articles</span></span>
        <Icon name="arrow-right" class="size-5 shrink-0 text-foreground-2 transition-colors duration-300 group-hover:text-accent-1 motion-reduce:transition-none" aria-hidden="true" />
      </a>
    </article>
    <ReadingToc headings={headings} />
  </div>
</BaseLayout>
