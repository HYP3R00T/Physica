---
import { render } from "astro:content"
import Callout from "@/components/common/Callout.astro"
import { Icon } from "astro-icon/components"
import { buttonVariants } from "@/components/ui/button"
import { getModuleSlug, type LearningEntry } from "@/lib/content"
import RoadmapPrerequisites from "./RoadmapPrerequisites.astro"
import type { RoadmapEntry, RoadmapSegment } from "@/lib/roadmap"

interface Props {
  module?: LearningEntry
  entry: RoadmapEntry
  initial: boolean
  prerequisites: RoadmapSegment[]
}

const { entry, initial, prerequisites, module } = Astro.props
const { Content } = await render(entry)
---

<article
  id={`panel-${entry.id.toLowerCase()}`}
  data-segment-panel={entry.id}
  hidden={!initial}
  aria-labelledby={`title-${entry.id.toLowerCase()}`}
  tabindex="-1"
>
  <header class="prose mb-8">
    <h1 id={`title-${entry.id.toLowerCase()}`}>{entry.data.title}</h1>
  </header>
  {entry.data.draft && (
    <div class="prose mb-8">
      <Callout title="Draft content" color="yellow">
        <p>This content is still being revised. Explanations and references may change as we review it.</p>
      </Callout>
    </div>
  )}
  {module && (
    <section data-roadmap-module class="grain-surface grain-surface--always mb-8 rounded-xl bg-background-1 p-6" aria-labelledby={`module-${entry.id}`}>
      <h2 id={`module-${entry.id}`} class="font-display text-2xl leading-tight font-semibold text-foreground-0">{module.data.title}</h2>
      <div class="mt-5">
        <a href={`/${getModuleSlug(module)}`} class={buttonVariants({ variant: "default" })}>
          Open module
          <Icon name="arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>
    </section>
  )}
  <RoadmapPrerequisites segmentId={entry.id} prerequisites={prerequisites} />
  <div class="prose mt-0 [&_:is(pre,table)]:max-w-full [&_:is(pre,table)]:overflow-x-auto [&_a]:wrap-anywhere"><Content /></div>
</article>
