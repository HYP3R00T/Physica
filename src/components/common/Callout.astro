---
import { Icon } from "astro-icon/components"

interface Props {
  title: string
  color?: "neutral" | "red" | "orange" | "yellow" | "green" | "teal" | "cyan" | "blue" | "purple" | "pink"
  icon?: string
}

const { title, color = "neutral", icon } = Astro.props
const colors = new Set(["red", "orange", "yellow", "green", "teal", "cyan", "blue", "purple", "pink"])
const accent = colors.has(color) ? `var(--${color}-0)` : "var(--foreground-2)"
---

<aside class="callout" aria-label={title} style={`--callout-accent: ${accent}`} >
  {icon ? <Icon name={icon} class="callout-icon" aria-hidden="true" /> : (
  <svg class="callout-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 11v6M12 7v1" />
  </svg>
  )}
  <div class="callout-content">
    <p class="callout-title">{title}</p>
    <div class="callout-body"><slot /></div>
  </div>
</aside>
