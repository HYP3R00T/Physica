---
import { render } from "astro:content"
import { Icon } from "astro-icon/components"
import ModuleRoadmapLink from "./ModuleRoadmapLink.astro"

import NotesLayout from "@/layouts/NotesLayout.astro"
import AuthorLinks from "./AuthorLinks.astro"
import { getModuleSlug, getNoteSlug } from "@/lib/content"
import type { LearningEntry } from "@/lib/content"

interface Props {
  note: LearningEntry
  module: LearningEntry
  notes: LearningEntry[]
}

const { note, module, notes } = Astro.props as Props
const { Content, headings } = await render(note)
const noteIndex = notes.findIndex((entry) => entry.id === note.id)
const previous = notes[noteIndex - 1]
const next = notes[noteIndex + 1]
const tableOfContents = headings.filter(({ depth }) => depth === 2 || depth === 3)

---

<NotesLayout
  title={note.data.title}
  description={note.data.description}
  module={module}
  notes={notes}
  currentId={note.id}
  headings={headings}
>
  <article>
    <header class="grain-surface grain-surface--always mt-10 rounded-xl bg-background-1 p-6 md:-mx-6 md:mt-16 md:p-6">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 font-mono text-xs">
        <a href={`/${getModuleSlug(module)}`} class="inline-flex items-center gap-2 text-accent-1 transition-colors hover:text-accent-2"><Icon name="arrow-left" class="size-3.5" aria-hidden="true" />{module.data.title}</a>
        {note.data.draft && <span class="rounded-md bg-orange-0/10 px-2.5 py-1 font-medium text-orange-0">Work in progress</span>}
      </div>

      <h1 class="mt-8 font-display text-[clamp(2.4rem,4vw,3.5rem)] leading-[1.08] font-medium tracking-tight text-foreground-0">
        {note.data.title}
      </h1>
      {note.data.description && <p class="mt-5 max-w-2xl text-lg leading-8 text-foreground-2">{note.data.description}</p>}

      <div class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-foreground-2">
          {note.data.authors.length > 0 && <AuthorLinks authors={note.data.authors} />}
        </p>
        <ModuleRoadmapLink module={module} />
      </div>
    </header>

    {tableOfContents.length > 0 && <details class="mt-6 rounded-lg bg-background-1 p-4 min-[72rem]:hidden">
      <summary class="cursor-pointer font-mono text-sm text-foreground-1">On this page</summary>
      <nav class="mt-4 grid gap-2" aria-label="Note sections">
        {tableOfContents.map((heading) => <a class:list={["text-sm leading-6 text-foreground-2 hover:text-accent-1", heading.depth === 3 && "pl-3"]} href={`#${heading.slug}`}>{heading.text}</a>)}
      </nav>
    </details>}

    <div class="prose pt-12 pb-12">
      <Content />
    </div>

    {(previous || next) && <nav class="mb-20 grid gap-3 sm:grid-cols-2" aria-label="Continue through the module">
      {previous && <a href={`/${getNoteSlug(previous)}`} class="grain-surface grain-surface--hover group flex min-h-28 flex-col justify-between rounded-xl bg-background-1 p-5 transition-colors duration-300 hover:bg-background-2/70 focus-visible:outline-2 focus-visible:outline-accent-1 focus-visible:outline-offset-2 motion-reduce:transition-none">
        <span class="flex items-center gap-2 font-mono text-xs text-foreground-3"><Icon name="arrow-left" class="size-4" aria-hidden="true" /> Previous note</span>
        <span class="font-display text-lg font-medium text-foreground-0 transition-colors duration-300 group-hover:text-accent-1 motion-reduce:transition-none">{previous.data.title}</span>
      </a>}
      {next && <a href={`/${getNoteSlug(next)}`} class:list={["grain-surface grain-surface--hover group flex min-h-28 flex-col justify-between rounded-xl bg-background-1 p-5 transition-colors duration-300 hover:bg-background-2/70 focus-visible:outline-2 focus-visible:outline-accent-1 focus-visible:outline-offset-2 motion-reduce:transition-none", !previous && "sm:col-start-2"]}>
        <span class="flex items-center justify-end gap-2 font-mono text-xs text-foreground-3">Next note <Icon name="arrow-right" class="size-4" aria-hidden="true" /></span>
        <span class="text-right font-display text-lg font-medium text-foreground-0 transition-colors duration-300 group-hover:text-accent-1 motion-reduce:transition-none">{next.data.title}</span>
      </a>}
    </nav>}
  </article>
</NotesLayout>
