---
import { Icon } from "astro-icon/components"
import { getModuleSlug, type LearningEntry } from "@/lib/content"

interface Props {
  module: LearningEntry
  noteCount: number
}
const { module, noteCount } = Astro.props
---

<a class="grain-surface grain-surface--hover module-card group flex min-h-64 flex-col rounded-xl bg-background-1 p-7 transition-colors duration-300 hover:bg-background-2/70 focus-visible:outline-2 focus-visible:outline-accent-1 focus-visible:outline-offset-4 motion-reduce:transition-none md:p-9" href={`/${getModuleSlug(module)}`}>
  <div class="flex w-full items-start justify-between gap-5">
    <p class="font-mono text-[.7rem] text-foreground-2">{noteCount} {noteCount === 1 ? "note" : "notes"} available{module.data.draft && <span class="ml-2 text-orange-0">· Draft</span>}</p>
    <Icon name="arrow-right" class="size-5 shrink-0 text-foreground-2 transition-colors duration-300 group-hover:text-accent-1 motion-reduce:transition-none" aria-hidden="true" />
  </div>
  <div class="mt-auto pt-12">
    <h2 class="font-display text-[clamp(1.55rem,2.5vw,2rem)] font-medium tracking-tight transition-colors duration-300 group-hover:text-accent-1 motion-reduce:transition-none">{module.data.title}</h2>
    {module.data.description && <p class="mt-3 text-sm leading-[1.7] text-foreground-2">{module.data.description}</p>}
  </div>
</a>
