---
import { getEntries } from "astro:content"
import type { CollectionEntry } from "astro:content"
import AuthorPreview from "./AuthorPreview"

interface Props {
  authors: CollectionEntry<"posts">["data"]["authors"]
}

const { authors } = Astro.props as Props
const profiles = await getEntries(authors)
---

{profiles.length > 0 && <span>By {profiles.map((author, index) => <><AuthorPreview id={author.id} author={author.data} client:load />{index < profiles.length - 1 && ", "}</>)}</span>}
