---
import { Icon } from "astro-icon/components"
import type { LearningEntry } from "@/lib/content"
import { getRoadmap } from "@/lib/roadmap"

interface Props { module: LearningEntry }
const { module } = Astro.props
const segment = module.data.roadmap
  ? (await getRoadmap()).segments.find(({ id }) => id === module.data.roadmap)
  : undefined
---

{segment && (
  <nav data-module-roadmap class="mt-6" aria-label="Physics roadmap">
    <a href={`/roadmap#segment-${segment.id}`} class="inline-flex items-center gap-2 text-sm text-accent-1 hover:text-accent-2 focus-visible:outline-2 focus-visible:outline-ring">
      <span>See {segment.title} on the roadmap</span>
      <Icon name="arrow-up-right" class="size-4 shrink-0" aria-hidden="true" />
    </a>
  </nav>
)}
