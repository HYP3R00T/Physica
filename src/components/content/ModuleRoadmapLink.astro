---
import { Icon } from "astro-icon/components"
import type { LearningEntry } from "@/lib/content"
import { getRoadmap } from "@/lib/roadmap"

interface Props { module: LearningEntry }
const { module } = Astro.props
const segment = module.data.roadmap
  ? (await getRoadmap()).segments.find(({ id }) => id === module.data.roadmap)
  : undefined
---

{segment && (
  <a data-module-roadmap href={`/roadmap#segment-${segment.id}`} class="inline-flex items-center gap-2 rounded-md py-1 text-sm font-medium text-accent-1 transition-colors duration-300 hover:text-accent-2 focus-visible:outline-2 focus-visible:outline-accent-1 focus-visible:outline-offset-2 motion-reduce:transition-none">
    <span>View on roadmap</span>
    <Icon name="arrow-right" class="size-4 shrink-0" aria-hidden="true" />
  </a>
)}
