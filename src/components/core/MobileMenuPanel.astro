---
import { SITE } from "@data/config";
import type { NavItem } from "@/lib/types";

interface Props {
  navItems: NavItem[];
  contactItem?: NavItem;
}

const { navItems, contactItem } = Astro.props as Props;

import { Icon } from "astro-icon/components";
import ModeToggle from "@/components/core/ModeToggle.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href.startsWith("/") && (href === "/" ? pathname === href : pathname.startsWith(href));
---

<div
  data-mobile-menu-backdrop
  data-open="false"
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-16 z-50 h-[calc(100dvh-4rem)] bg-background-0/40 opacity-0 backdrop-blur-sm transition-opacity duration-150 data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 motion-reduce:transition-none md:hidden"
></div>
<div
  id="mobile-menu"
  data-mobile-menu
  data-open="false"
  class="pointer-events-none fixed inset-x-0 z-60 max-h-0 overflow-hidden opacity-0 transition-opacity duration-150 ease-out data-[open=true]:pointer-events-auto data-[open=true]:max-h-[calc(100svh-4rem)] data-[open=true]:overflow-y-auto data-[open=true]:opacity-100 motion-reduce:transition-none md:hidden"
  role="dialog"
  aria-hidden="true"
>
  <div class="site-grid-frame border-b bg-background-0">
    <nav class="grid divide-y divide-border" aria-label="Mobile navigation">
      {
        navItems.map((item) => {
          const isExternal = item.blank || item.href.startsWith("http");

          return (
            <a
              href={item.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class="flex min-h-14 items-center justify-between px-5 py-3 font-display text-lg text-foreground-1 transition-colors hover:bg-background-1 hover:text-accent-1 aria-[current=page]:text-accent-1"
            >
              <span>{item.label}</span>
              {isExternal ? (
                <Icon name="arrow-up-right" class="size-4 text-foreground-3" aria-hidden="true" />
              ) : null}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center border-t border-border">
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View Physica source on GitHub (opens in a new tab)"
        title="View source on GitHub"
        class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-16 shrink-0 text-foreground-2")}
      >
        <Icon name="github" class="size-4" aria-hidden="true" />
      </a>
      <ModeToggle className="size-16 shrink-0" />
      {
        contactItem && (
          <a
            href={contactItem.href}
            target={contactItem.blank ? "_blank" : undefined}
            rel={contactItem.blank ? "noopener noreferrer" : undefined}
            class="flex min-h-16 flex-1 items-center justify-center bg-primary px-5 font-display text-base font-medium text-primary-foreground transition-colors hover:bg-primary/80"
          >
            {contactItem.label}
          </a>
        )
      }
    </div>
  </div>
</div>
