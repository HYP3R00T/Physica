---
import { SITE, navItems } from "@data/config";
import { ModeToggle } from "@/components/core/ModeToggle";
import { SearchPalette } from "@/components/core/SearchPalette";
import AnimatedText from "@/components/common/AnimatedText.tsx";
import MobileMenuToggle from "@/components/core/MobileMenuToggle.astro";
import MobileMenuPanel from "@/components/core/MobileMenuPanel.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const visibleNavItems = navItems.filter((item) => !item.special);
const blogItem = visibleNavItems.find((item) => item.href === "/post");
const contactItem = visibleNavItems.find((item) => item.href === "/contact");
const primaryNavItems = visibleNavItems.filter((item) => item.href !== "/contact");
---

<header
  data-header-shell
  data-menu-open="false"
  class="sticky top-0 z-80 border-b border-border bg-background-0/90 backdrop-blur-xl"
>
  <div
    data-header-nav
    data-menu-open="false"
    transition:animate="none"
    class="site-grid-frame grid min-h-16 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:grid-cols-[minmax(12rem,1fr)_auto_minmax(12rem,1fr)]"
  >
    <div class="flex min-w-0 items-center px-5 lg:px-8">
      <a href="/" class="flex min-w-0 flex-row font-mono text-base md:text-lg" aria-label={`${SITE.title} home`}>
        <AnimatedText client:load text={SITE.title.toLowerCase()} className="text-accent-1" auto={true} hover={true} />
      </a>
    </div>

    <div class="flex min-w-0 items-center justify-center px-2">
      <SearchPalette client:load />
    </div>

    <div class="hidden min-w-0 items-center justify-end gap-2 px-5 md:flex lg:px-8">
      {blogItem && (
        <nav aria-label="Primary navigation">
          <a
            href={blogItem.href}
            aria-current={Astro.url.pathname === "/post" || Astro.url.pathname.startsWith("/post/") ? "page" : undefined}
            class="rounded-md px-3 py-2 font-mono text-sm text-foreground-2 transition-colors hover:text-accent-1 aria-[current=page]:text-accent-1"
          >
            {blogItem.label}
          </a>
        </nav>
      )}
      <ModeToggle
        client:load
        className="size-10 border-0 hover:bg-transparent hover:text-foreground-0"
      />
      {
        contactItem && (
          <a
            href={contactItem.href}
            class={cn(
              buttonVariants({ variant: "default" }),
              "h-9 border-0 bg-accent-1 px-4 text-background-0 hover:bg-accent-2",
            )}
          >
            {contactItem.label}
          </a>
        )
      }
    </div>

    <div class="justify-self-end md:hidden">
      <MobileMenuToggle />
    </div>
  </div>
  <MobileMenuPanel navItems={primaryNavItems} contactItem={contactItem} />
</header>
