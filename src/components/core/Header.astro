---
import { SITE, navItems } from "@data/config";
import { ModeToggle } from "@/components/core/ModeToggle";
import { SearchPalette } from "@/components/core/SearchPalette";
import AnimatedText from "@/components/common/AnimatedText.tsx";
import MobileMenuToggle from "@/components/core/MobileMenuToggle.astro";
import MobileMenuPanel from "@/components/core/MobileMenuPanel.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const visibleNavItems = navItems.filter((item) => !item.special);
const contactItem = visibleNavItems.find((item) => item.href === "/contact");
const primaryNavItems = visibleNavItems.filter((item) => item.href !== "/contact");
---

<header
  data-header-shell
  data-menu-open="false"
  class="sticky top-0 z-80 border-b border-border bg-background-0/90 backdrop-blur-xl"
>
  <div
    data-header-nav
    data-menu-open="false"
    transition:animate="none"
    class="site-grid-frame flex min-h-16 items-center justify-between gap-4"
  >
    <div class="flex min-w-0 items-center gap-8 pl-5 lg:gap-12 lg:pl-8">
      <a href="/" class="flex shrink-0 flex-row font-mono text-base md:text-lg" aria-label={`${SITE.title} home`}>
        <AnimatedText client:load text={SITE.title.toLowerCase()} className="text-accent-1" auto={true} hover={true} />
      </a>
      <nav aria-label="Primary navigation" class="hidden items-center gap-5 md:flex">
        {primaryNavItems.map((item) => (
          <a
            href={item.href}
            target={item.blank ? "_blank" : undefined}
            rel={item.blank ? "noopener noreferrer" : undefined}
            aria-current={Astro.url.pathname === item.href || Astro.url.pathname.startsWith(`${item.href}/`) ? "page" : undefined}
            class="rounded-md py-2 font-mono text-sm text-foreground-2 transition-colors hover:text-accent-1 aria-[current=page]:text-accent-1"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-2 md:gap-3 md:pr-5 lg:pr-8">
      <SearchPalette client:load />
      <div class="hidden md:block">
        <ModeToggle
          client:load
          className="size-10 border-0 hover:bg-transparent hover:text-foreground-0"
        />
      </div>
      {
        contactItem && (
          <a
            href={contactItem.href}
            class={cn(
              buttonVariants({ variant: "default" }),
              "hidden h-9 border-0 bg-accent-1 px-4 text-background-0 hover:bg-accent-2 md:inline-flex",
            )}
          >
            {contactItem.label}
          </a>
        )
      }
      <div class="md:hidden">
        <MobileMenuToggle />
      </div>
    </div>
  </div>
  <MobileMenuPanel navItems={primaryNavItems} contactItem={contactItem} />
</header>
