---
import type { PostEntry } from "@/lib/types"
import { formatDateUppercase } from "@/lib/utils"
import AuthorLinks from "@/components/content/AuthorLinks.astro"
interface Props { post: PostEntry; index?: number }
const { post, index = 0 } = Astro.props
---
<article class:list={["group relative flex h-full min-h-72 flex-col border-b border-border px-5 py-10 transition-colors hover:bg-background-1 md:px-10 lg:px-15", index % 2 === 0 && "md:border-r"]}>
  <a href={`/post/${post.id}`} class="absolute inset-0" aria-label={post.data.title}></a>
  <div class="flex items-start justify-between gap-6">
    <p class="font-mono text-xs text-foreground-3">{post.data.featured && "Featured · "}{formatDateUppercase(post.data.pubDatetime)}</p>
    <span class="h-px w-10 bg-border transition-[width,background-color] group-hover:w-16 group-hover:bg-accent-1" aria-hidden="true" />
  </div>
  <h2 class="mt-14 font-display text-2xl font-semibold text-foreground-0 group-hover:text-accent-1">{post.data.title}</h2>
  <p class="mt-3 leading-7 text-foreground-2">{post.data.description}</p>
  {post.data.authors.length > 0 && <p class="relative z-10 mt-5 w-fit font-mono text-xs text-foreground-3"><AuthorLinks authors={post.data.authors} /></p>}
  <ul class="mt-auto flex flex-wrap gap-2 pt-6" aria-label={`${post.data.title} topics`}>{post.data.tags.map((tag) => <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-foreground-2">{tag}</li>)}</ul>
</article>
