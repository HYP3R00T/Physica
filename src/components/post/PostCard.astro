---
import type { PostEntry } from "@/lib/types"
import { formatDateUppercase } from "@/lib/utils"
import AuthorLinks from "@/components/content/AuthorLinks.astro"
interface Props { post: PostEntry }
const { post } = Astro.props
---
<article class:list={["group relative rounded-xl bg-background-1 p-7 transition-colors duration-300 hover:bg-background-2/70 motion-reduce:transition-none md:p-9", post.data.featured && "grain-surface grain-surface--always post-card-featured md:py-11"]}>
  <a href={`/post/${post.id}`} class="absolute inset-0" aria-label={post.data.title}></a>
  <p class="font-mono text-xs text-foreground-3">{post.data.featured && "Featured · "}{formatDateUppercase(post.data.pubDatetime)}</p>
  <h2 class="mt-4 font-display text-2xl font-medium text-foreground-0 transition-colors duration-300 group-hover:text-accent-1 motion-reduce:transition-none md:text-3xl">{post.data.title}</h2>
  <p class="mt-3 max-w-2xl leading-7 text-foreground-2">{post.data.description}</p>
  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-foreground-3">
    {post.data.authors.length > 0 && <p class="relative z-10 w-fit font-mono"><AuthorLinks authors={post.data.authors} /></p>}
    <ul class="flex flex-wrap gap-x-3 font-mono" aria-label={`${post.data.title} topics`}>{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
  </div>
</article>
